# -- template models/__init__.py.jinja --
"""
Lazy-loading models module.

Each model is in its own file and loaded on-demand when accessed.
This reduces memory usage for large schemas where only a subset of models are used.
"""
from typing import TYPE_CHECKING, Any

# Cache for loaded models
_model_cache: dict[str, Any] = {}
# Track models currently being rebuilt to prevent infinite recursion
_rebuilding: set[str] = set()


def __getattr__(name: str) -> Any:
    """Lazy load model classes on first access.

    Args:
        name: The model class name to load

    Returns:
        The model class

    Raises:
        AttributeError: If the model doesn't exist
    """
    if name in _model_cache:
        return _model_cache[name]

    # Try to import the model from its file
    try:
        import importlib
        import sys

        # Model files are named _<lowercase_model_name>.py
        module_name = f'._{name.lower()}'
        module = importlib.import_module(module_name, package=__name__)
        model_class = getattr(module, name)

        # Cache the model class first, before calling model_rebuild
        # This allows circular references to find the class
        _model_cache[name] = model_class

        # Rebuild the model to resolve forward references, but only if not already rebuilding
        # to prevent infinite recursion with circular dependencies
        if name not in _rebuilding:
            _rebuilding.add(name)
            try:
                # Pass the models module (self) as namespace for forward reference resolution
                models_module = sys.modules[__name__]
                model_class.model_rebuild(_types_namespace={'models': models_module})
            finally:
                _rebuilding.discard(name)

        return model_class
    except (ImportError, AttributeError) as e:
        raise AttributeError(f"module '{__name__}' has no attribute '{name}'") from e


def __dir__() -> list[str]:
    """Return list of available model names."""
    return [
        {% for model in dmmf.datamodel.models -%}
        '{{ model.name }}',
        {% endfor -%}
    ]


# For type checking, import all models
if TYPE_CHECKING:
    # Import individual model files for type checking
    {%- for model in dmmf.datamodel.models %}
    from ._{{ model.name.lower() }} import {{ model.name }}
    {%- endfor %}
