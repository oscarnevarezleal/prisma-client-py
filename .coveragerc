[run]
branch = True
# `thread` is required alongside `multiprocessing` so coverage traces code that
# runs in worker threads (e.g. prisma._recursive.run_with_recursion_headroom and
# its tests); without it those lines show as uncovered.
concurrency = multiprocessing, thread

source =
    tests
    prisma
    databases

omit =
    *.py.jinja
    prisma/partial_types.py
    # generated code
    */prisma/types.py
    */prisma/enums.py
    */prisma/client.py
    */prisma/models.py
    */prisma/actions.py
    */prisma/partials.py
    # we still want to include these
    # */prisma/builder.py
    # */prisma/engine/query.py


# `@needs_pyright` marks the one test that shells out to pyright. It is excluded
# rather than run everywhere because pyright pulls a node runtime down on first
# use, which is too much to put in all eleven test jobs; `ruff` and
# `mypy --strict` cover the same emitted source there, and this stays as extra
# assurance wherever pyright happens to be installed.
[report]
exclude_lines =
    pragma: no cover
    mark: filedef
    @pytest.mark.skip\(?
    @needs_pyright
    if TYPE_CHECKING
    \.\.\.

partial_branches =
    pragma: no branch
    if not TYPE_CHECKING:

[paths]
prisma =
    src/prisma
    */**/prisma
