datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-py"
  minimalRuntime = true
  separateModelFiles = true
}

model Model0 {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  description String?
  isActive    Boolean  @default(true)
  count       Int      @default(0)
  price       Float?
  data        String?
}

