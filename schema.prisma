model TestUser {
  id    Int    @id @default(autoincrement())
  name  String
  posts TestPost[]
}

model TestPost {
  id       Int    @id @default(autoincrement())
  title    String
  author   TestUser   @relation(fields: [authorId], references: [id])
  authorId Int
}
